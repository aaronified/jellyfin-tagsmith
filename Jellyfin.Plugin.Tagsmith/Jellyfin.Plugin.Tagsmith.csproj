<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Version>0.2.1</Version>
    <RootNamespace>Jellyfin.Plugin.Tagsmith</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the target server version, or the plugin loads as NotSupported. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Data\countries.json.gz" />
    <EmbeddedResource Include="Data\countries.json.gz" />
    <!-- Generated by scripts/generate-awards.mjs and generate-lists.mjs. Conditional so a
         checkout without the datasets still builds; CuratedData loads them as empty. -->
    <None Remove="Data\awards.json.gz" />
    <EmbeddedResource Include="Data\awards.json.gz" Condition="Exists('Data\awards.json.gz')" />
    <None Remove="Data\lists.json.gz" />
    <EmbeddedResource Include="Data\lists.json.gz" Condition="Exists('Data\lists.json.gz')" />
  </ItemGroup>

</Project>
