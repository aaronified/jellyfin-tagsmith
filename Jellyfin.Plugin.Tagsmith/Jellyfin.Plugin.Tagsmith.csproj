<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.0.3.0</AssemblyVersion>
    <FileVersion>0.0.3.0</FileVersion>
    <Version>0.0.3</Version>
    <RootNamespace>Jellyfin.Plugin.Tagsmith</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the target server version, or the plugin loads as NotSupported. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Data\countries.json.gz" />
    <EmbeddedResource Include="Data\countries.json.gz" />
  </ItemGroup>

</Project>
